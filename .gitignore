# Byte-compiled / packaged Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/
.env

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.tox/
.nox/
.hypothesis/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Notebook checkpoints
.ipynb_checkpoints/

# Demo output directory referenced by the README
figures/

# Trained model checkpoints (large binaries; the committed record is the small
# JSON model card written next to them by sonic_ml.models.save_with_card).
*.pt
*.ckpt

# Third-party real-world log files fetched by scripts/fetch_real_data.py.
# These are downloaded on demand and MUST NOT be committed: they are published
# by others under their own terms (one carries a third-party copyright notice
# in its own header), and this repository has no redistribution rights.
tests/data/real/

# Sphinx build artifacts
docs/_build/
docs/generated/

# Claude Code — personal / local memory & settings (do not commit).
# Shared memory (CLAUDE.md, .claude/rules, .claude/skills, .claude/settings.json)
# IS committed; only the per-developer overrides below are ignored.
CLAUDE.local.md
.claude/settings.local.json
